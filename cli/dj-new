#!/usr/bin/env python3
"""Create a data-journalism project from the repository template."""

from __future__ import annotations

import argparse
import shutil
import sys
from pathlib import Path


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="dj-new",
        description="Create a small data-journalism project.",
    )
    parser.add_argument("project_name", help="Name of the new project directory")
    parser.add_argument(
        "--parent",
        type=Path,
        default=Path.cwd(),
        help="Directory in which to create the project (default: current directory)",
    )
    return parser.parse_args()


def validate_project_name(project_name: str) -> None:
    candidate = Path(project_name)
    if (
        not project_name.strip()
        or project_name in {".", ".."}
        or candidate.name != project_name
        or candidate.is_absolute()
    ):
        raise ValueError("PROJECT_NAME must be one directory name, not a path")


def main() -> int:
    args = parse_args()

    try:
        validate_project_name(args.project_name)
    except ValueError as error:
        print(f"dj-new: {error}", file=sys.stderr)
        return 2

    template_dir = Path(__file__).resolve().parents[1] / "templates" / "project"
    parent_dir = args.parent.expanduser().resolve()
    target_dir = parent_dir / args.project_name

    if not template_dir.is_dir():
        print(f"dj-new: template not found: {template_dir}", file=sys.stderr)
        return 1
    if not parent_dir.is_dir():
        print(f"dj-new: parent directory does not exist: {parent_dir}", file=sys.stderr)
        return 1
    if target_dir.exists():
        print(f"dj-new: target already exists: {target_dir}", file=sys.stderr)
        return 1

    shutil.copytree(template_dir, target_dir)
    print(f"Created {target_dir}")
    print("Next: edit README.md, then open scripts/01_get_data.qmd")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

